# === Генерация постеров (ImageGenerationService, ТЗ v2.2) ===
# Глобальный рубильник: False = весь бот бесшовно работает в текстовом режиме.
ENABLE_IMAGE_GENERATION=True
# playwright | pillow (pillow — fallback для слабых серверов без Chromium).
IMAGE_RENDER_ENGINE=playwright
# Одновременных рендеров (semaphore). 2 = пик RAM ~900 МБ на 3.5 ГБ свободных.
IMAGE_MAX_CONCURRENT_RENDERS=2
# Максимум ждущих в очереди; сверх — мгновенный текстовый fallback.
IMAGE_QUEUE_CAPACITY=3
# Общий бюджет запроса: ожидание слота + рендер, секунды.
IMAGE_RENDER_TIMEOUT_SEC=4.0
# Рецикл браузера: не более N рендеров на процесс...
IMAGE_BROWSER_RECYCLE_RENDERS=200
# ...и не старше N минут (что наступит раньше).
IMAGE_BROWSER_RECYCLE_INTERVAL_MIN=720
# Ширина постера, px. 1080 переживает JPEG-компрессию Telegram.
POSTER_WIDTH=1080
# Rate limit: генераций на пользователя за окно. Расходуется только
# на фактический рендер; кэш-хиты и warm-up лимит не расходуют.
IMAGE_RATE_LIMIT_MAX=10
IMAGE_RATE_LIMIT_WINDOW_SEC=180
# L1 (PNG-байты) / L2 (file_id): TTL записей и предел числа записей.
IMAGE_CACHE_TTL_HOURS=24
IMAGE_CACHE_MAXSIZE=200
# Circuit breaker: серия ошибок рендера до размыкания цепи
# и пауза (сек) перед пробной попыткой half-open.
IMAGE_BREAKER_FAILURE_THRESHOLD=5
IMAGE_BREAKER_COOLDOWN_SEC=120
