{%- filter trim %}
{# ==========================================================
   УВЕДОМЛЕНИЯ (MorningSummaryDTO) — перенос render_morning_summary в Jinja2
   Принцип: показываем расписание "как есть", БЕЗ было/стало.
   Замены/отмены видны только через иконку и зачёркнутый текст.
   При отмене пишем предмет, который был до замены — слово "ОТМЕНА" не пишем.
   Учителей показываем под tg-spoiler. 
   
   ИЗМЕНЕНО: добавлена Умная Агрегация Труда(технология), которая склеивает 
   предмет, если он единственный реальный в слоте (исключая окна), и 
   расщепляет в дерево, если идет вместе с другими предметами (Информатика).
   Контекст, который должен прийти в шаблон: dto, date_text
   (dto — тот же MorningSummaryDTO/MorningLessonDTO, что и в исходном коде;
   date_text — результат UIRenderer._format_short_date(dto.date_iso), т.к.
   форматирование дат остаётся на стороне Python).
   ========================================================== #}

{# ---------- ХЕЛПЕР: список "Весь класс/ALL/None/—" для исключения группы ---------- #}
{%- set HIDDEN_GROUP_VALUES = ['Весь класс', 'ALL', 'None', '', '—'] -%}

{# ==========================================================
   МАКРОС: детали урока (аналог _render_teacher_lesson_details /
   _render_student_lesson_details). Порядок полей и их состав —
   как в исходном Python-коде, оформление — как в шаблоне расписания
   (класс — <b>, группа — <i>, кабинет — <b>[...]</b>, учитель — спойлер).
   ========================================================== #}
{%- macro lesson_details(lesson, is_teacher) -%}
    {%- set parts = [] -%}
    {%- if is_teacher -%}
        {#- 1. Класс -#}
        {%- if lesson.class_name %}{% set _ = parts.append(('<b>{}</b>' | safe).format(lesson.class_name)) %}{% endif -%}
        {#- 2. Группа -#}
        {%- if lesson.group_name and (lesson.group_name | string | trim) not in HIDDEN_GROUP_VALUES %}{% set _ = parts.append(('<i>{}</i>' | safe).format(lesson.group_name)) %}{% endif -%}
        {#- 3. Кабинет -#}
        {%- if lesson.room_name %}{% set _ = parts.append(('<b>[{}]</b>' | safe).format(lesson.room_name)) %}{% endif -%}
    {%- else -%}
        {#- ИЗМЕНЕНО: учитель теперь всегда под tg-spoiler -#}
        {%- if lesson.teacher_name %}{% set _ = parts.append(('<tg-spoiler><i>{}</i></tg-spoiler>' | safe).format(lesson.teacher_name)) %}{% endif -%}
        {%- if lesson.room_name %}{% set _ = parts.append(('<b>[{}]</b>' | safe).format(lesson.room_name)) %}{% endif -%}
    {%- endif -%}
    {{- parts | join(' · ') | safe -}}
{%- endmacro -%}

{# ==========================================================
   МАКРОС: вычисление отображаемого предмета для одного урока.
   При отмене — показываем предмет ДО замены (original_subject_name),
   слово "ОТМЕНА" больше не пишем нигде.
   ========================================================== #}
{%- macro lesson_subject(lesson, is_teacher) -%}
    {%- if lesson.is_cancelled -%}
        {{- (lesson.original_subject_name if lesson.original_subject_name else (lesson.subject_name or '—')) | e -}}
    {%- elif is_teacher and lesson.is_methodological -%}
        Методический час
    {%- else -%}
        {{- (lesson.subject_name or '—') | e -}}
    {%- endif -%}
{%- endmacro -%}

{# ==========================================================
   МАКРОС: иконка для группы уроков (аналог блока if/elif в
   _render_morning_lesson_group).
   ========================================================== #}
{%- macro group_icon(group, is_teacher) -%}
    {%- if group | rejectattr('is_cancelled') | list | length == 0 -%}❌
    {%- elif group | selectattr('is_exchange') | list | length > 0 -%}🔄
    {%- elif group | selectattr('is_extra') | list | length > 0 -%}🎨
    {%- elif is_teacher and (group | rejectattr('is_methodological') | list | length == 0) -%}🧑‍🏫
    {%- else -%}📚
    {%- endif -%}
{%- endmacro -%}

{# ==========================================================
   МАКРОС: рендер группы уроков одного слота (номер + время).
   СЦЕНАРИЙ 0 (is_extra): дополнительное занятие.
   СЦЕНАРИЙ 1.5: Агрегированный Труд (умная логика).
   СЦЕНАРИЙ 1 (len == 1): обычный одиночный урок.
   СЦЕНАРИЙ 2 (len > 1): расщеплённый урок (несколько подгрупп).
   ========================================================== #}
{%- macro render_lesson_group(group, is_teacher) -%}
    {%- set base = group[0] -%}
    {%- set display_num = base.display_num or (base.lesson_num | string if base.lesson_num is not none else '•') -%}
    {%- set time_text = (base.start_time or '') ~ '–' ~ (base.end_time or '') -%}
    {%- set icon = group_icon(group, is_teacher) | trim -%}

    {%- if base.is_extra -%}
        {# --- СЦЕНАРИЙ 0: дополнительные занятия --- #}
        {%- for lesson in group -%}
            {%- if not loop.first %}{{ '\n' }}{% endif -%}
            🎨 <code>{{ lesson.start_time }}–{{ lesson.end_time }}</code> · <b>{{ (lesson.subject_name or '—') | e }}</b>{% if lesson.room_name %}{{ '\n' }}   ↳ <b>[{{ lesson.room_name | e }}]</b>{% endif %}
        {%- endfor -%}
    {%- else -%}
        {#- УМНАЯ АГРЕГАЦИЯ ТРУДА: вычисляем реальные предметы -#}
        {%- set real_subjs = [] -%}
        {%- for l in group -%}
            {%- set s_name = l.original_subject_name if l.is_cancelled and l.original_subject_name and l.original_subject_name != 'ОТМЕНА' else l.subject_name -%}
            {%- if s_name and s_name|lower not in ['отмена', 'нет занятий', ''] -%}
                {%- set _ = real_subjs.append(s_name|lower) -%}
            {%- endif -%}
        {%- endfor -%}
        {%- set unique_real_subjs = real_subjs | unique | list -%}
        {%- set is_trud_only = not is_teacher and group|length > 1 and unique_real_subjs|length == 1 and ('труд' in unique_real_subjs[0] or 'технологи' in unique_real_subjs[0]) -%}

        {%- if is_trud_only -%}
            {# --- СЦЕНАРИЙ 1.5: Агрегированный Труд --- #}
            {%- set all_cancelled = group | rejectattr('is_cancelled') | list | length == 0 -%}
            {%- if all_cancelled -%}
                {{ icon }} <b>{{ display_num }}.</b> {{ time_text }} · <s><b>Труд(технология)</b></s>
            {%- else -%}
                {{ icon }} <b>{{ display_num }}.</b> {{ time_text }} · <b>Труд(технология)</b>
                {%- for lesson in group -%}
                    {%- set is_window = (lesson.subject_name == 'нет занятий') or (lesson.is_cancelled and lesson.original_subject_name == 'нет занятий') -%}
                    {%- if not lesson.is_cancelled and not is_window -%}
                        {%- set details = lesson_details(lesson, is_teacher) | trim | safe -%}
                        {{ '\n' }}   ↳ {{ details }}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
        {%- elif group | length == 1 -%}
            {# --- СЦЕНАРИЙ 1: обычный урок --- #}
            {%- set lesson = group[0] -%}
            {%- set is_window = (lesson.subject_name == 'нет занятий') or (lesson.is_cancelled and lesson.original_subject_name == 'нет занятий') -%}
            
            {%- if is_window -%}
                {{ icon }} <b>{{ display_num }}.</b> {{ time_text }} · нет занятий
            {%- else -%}
                {%- set subject = lesson_subject(lesson, is_teacher) | trim -%}
                {%- if lesson.is_cancelled -%}
                    {{ icon }} <b>{{ display_num }}.</b> {{ time_text }} · <s><b>{{ subject }}</b></s>
                {%- else -%}
                    {%- set details = lesson_details(lesson, is_teacher) | trim | safe -%}
                    {{ icon }} <b>{{ display_num }}.</b> {{ time_text }} · <b>{{ subject }}</b>{% if details %}{{ '\n' }}   ↳ {{ details }}{% endif %}
                {%- endif -%}
            {%- endif -%}
        {%- else -%}
            {# --- СЦЕНАРИЙ 2: расщеплённый урок (2+ подгрупп) --- #}
            {{ icon }} <b>{{ display_num }}.</b> {{ time_text }}
            {%- for lesson in group -%}
                {%- set is_window = (lesson.subject_name == 'нет занятий') or (lesson.is_cancelled and lesson.original_subject_name == 'нет занятий') -%}
                
                {%- if is_window -%}
                    {{ '\n' }}   ↳ нет занятий{% if lesson.group_name and (lesson.group_name | string | trim) not in HIDDEN_GROUP_VALUES %} · <i>{{ lesson.group_name }}</i>{% endif %}
                {%- else -%}
                    {%- set subject = lesson_subject(lesson, is_teacher) | trim -%}
                    {%- if lesson.is_cancelled -%}
                        {{ '\n' }}   ↳ <s><b>{{ subject }}</b></s>{% if lesson.group_name and (lesson.group_name | string | trim) not in HIDDEN_GROUP_VALUES %} · <i>{{ lesson.group_name }}</i>{% endif %}
                    {%- else -%}
                        {%- set details = lesson_details(lesson, is_teacher) | trim | safe -%}
                        {{ '\n' }}   ↳ <b>{{ subject }}</b>{% if details %} · {{ details }}{% endif %}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}

{# ==========================================================
   ХЕДЕР (аналог _render_morning_header)
   ========================================================== #}
{%- set is_teacher = dto.origin == "teacher" -%}

{%- if is_teacher -%}
    {%- set header_text -%}
👨‍🏫 <b>Расписание учителя на {{ date_text }}</b>
👤 <b>{{ (dto.teacher_name or "Учитель") | e }}</b>
    {%- endset -%}
{%- else -%}
    {%- set suffix_parts = [] -%}
    {%- if dto.class_name %}{% set _ = suffix_parts.append(dto.class_name | e) %}{% endif -%}
    {%- if dto.group_name and (dto.group_name | string | trim) not in HIDDEN_GROUP_VALUES %}{% set _ = suffix_parts.append(dto.group_name | e) %}{% endif -%}
    {%- set suffix = (' (' ~ (suffix_parts | join(' · ')) ~ ')') | safe if suffix_parts else '' -%}

    {%- set title = ('🌅 <b>Расписание на ' ~ date_text ~ '</b>') | safe -%}
    {%- if dto.child_name -%}
        {%- set target_line = ('👤 ' ~ (dto.child_name | e) ~ suffix) | safe -%}
    {%- elif suffix_parts -%}
        {%- set target_line = ('🎓 ' ~ (suffix_parts | join(' · '))) | safe -%}
    {%- else -%}
        {%- set target_line = '' -%}
    {%- endif -%}

    {%- set header_text = (title ~ ('\n' ~ target_line if target_line else '')) | safe -%}
{%- endif -%}

{# ==========================================================
   СТАТУС ПЕРЕСТАНОВОК (аналог _render_morning_status).
   ========================================================== #}
{%- set status_text = '' -%}
{%- if dto.origin == "student" and dto.has_permutation -%}
    {%- set status_text = '🔀 <i>Есть перестановки в расписании</i>' -%}
{%- endif -%}

{# ==========================================================
   СПИСОК УРОКОВ (аналог _render_morning_lessons)
   Группируем по (lesson_num, start_time), сохраняя порядок первого
   появления ключа — как defaultdict(list) в Python.
   ========================================================== #}
{%- set ns = namespace(done_keys=[], blocks=[]) -%}
{%- for lesson in dto.lessons -%}
    {%- set key = (lesson.lesson_num, lesson.start_time) -%}
    {%- if key not in ns.done_keys -%}
        {%- set _ = ns.done_keys.append(key) -%}
        {%- set group = dto.lessons
            | selectattr('lesson_num', 'equalto', lesson.lesson_num)
            | selectattr('start_time', 'equalto', lesson.start_time)
            | list -%}
        {%- set _ = ns.blocks.append(render_lesson_group(group, is_teacher) | trim | safe) -%}
    {%- endif -%}
{%- endfor -%}
{%- set lessons_text = ns.blocks | join('\n\n') -%}

{# ==========================================================
   ФУТЕР (аналог _render_morning_footer)
   ========================================================== #}
{%- set ns2 = namespace(changes_count=0) -%}
{%- for lesson in dto.lessons if not lesson.is_extra -%}
    {%- if lesson.is_exchange or lesson.is_cancelled -%}
        {%- set ns2.changes_count = ns2.changes_count + 1 -%}
    {%- endif -%}
{%- endfor -%}

{%- set footer_text = '' -%}
{%- if ns2.changes_count > 0 -%}
    {%- set footer_text -%}
🔄 Изменений: {{ ns2.changes_count }}
Нажмите кнопку ниже для подробностей.
    {%- endset -%}
{%- endif -%}

{# ==========================================================
   ФИНАЛЬНАЯ СБОРКА
   ========================================================== #}
{%- set final_parts = [] -%}
{%- if header_text | trim %}{% set _ = final_parts.append(header_text | trim | safe) %}{% endif -%}
{%- if status_text | trim %}{% set _ = final_parts.append(status_text | trim | safe) %}{% endif -%}
{%- if lessons_text | trim %}{% set _ = final_parts.append(lessons_text | trim | safe) %}{% endif -%}
{%- if footer_text | trim %}{% set _ = final_parts.append(footer_text | trim | safe) %}{% endif -%}
{{- (final_parts | join('\n\n')) | trim | safe -}}
{%- endfilter %}