{# {{ '\n' }} на {{ '\n\n' }} в строке {%- if not loop.first.... Это  главный рычаг управления межстрочным интервалом в Telegram.#}
{# ================= ШАПКА ================= #}
📅 <b>{{ formatted_date }}</b>{{ '\n' }}

{%- if dto.origin == "teacher" and name -%}
👨‍🏫 <b>{{ name }}</b>{{ '\n' }}
{%- elif dto.origin == "student" and name -%}
👤 <b>{{ name }}{% if dto.class_name %} · {{ dto.class_name }}{% endif %}{% if dto.group_name and dto.group_name not in ['Весь класс', 'ALL', 'None', '', '—'] %} · {{ dto.group_name }}{% endif %}</b>{{ '\n' }}
{%- elif dto.origin == "class" and dto.class_name -%}
🎓 <b>Класс: {{ dto.class_name }}</b>{{ '\n' }}
{%- endif -%}


{%- if dto.has_permutation %}
{%- endif %}

{# ================= УРОКИ ================= #}
{%- if not slots -%}
{{ '\n\n' }}🏖 <b>Занятий нет</b>
{%- else -%}
{%- for slot in slots -%}

{#- ТЕСТОВЫЙ РЫЧАГ ПРОБЕЛОВ: Этот тег ставит ровно 1 перенос между уроками. 
    Если нужно больше места, замени на {{ '\n\n' }} -#}
{%- if not loop.first %}{{ '\n' }}{% endif -%}

{%- set first = slot[0] -%}
{%- set start = first.start_time.zfill(5) if first.start_time else "00:00" -%}
{%- set end = first.end_time.zfill(5) if first.end_time else "00:00" -%}

{%- if first.is_extra -%}
{# --- ДОП. ЗАНЯТИЯ --- #}
{%- for ex in slot -%}
🎨 <code>{{ start }}–{{ end }}</code>
<blockquote><b>{{ ex.subject_name }}</b> 
{%- if ex.room_name and ex.room_name != "—" %} ➔ <i>{{ ex.room_name }}</i>{% endif -%}
</blockquote>
{%- if not loop.last %}{{ '\n' }}{% endif -%}
{%- endfor -%}

{%- else -%}
{# --- ОСНОВНЫЕ УРОКИ --- #}
{%- set is_all_cancelled = slot | rejectattr('is_cancelled') | list | length == 0 -%}

{#- Высчитываем тип иконки (🔄 или 🔁) с помощью namespace -#}
{%- set ns = namespace(has_subj_change=false, has_minor_change=false) -%}
{%- for l in slot if l.is_exchange -%}
    {%- if l.original_subject_name and l.original_subject_name != l.subject_name -%}
        {%- set ns.has_subj_change = true -%}
    {%- else -%}
        {%- set ns.has_minor_change = true -%}
    {%- endif -%}
{%- endfor -%}

{%- set is_methodological = is_teacher and (slot | rejectattr('is_methodological') | list | length == 0) -%}
{%- set icon = '❌' if is_all_cancelled else ('🔄' if ns.has_subj_change else ('🔁' if ns.has_minor_change else ('🧑‍🏫' if is_methodological else '📚'))) -%}
{%- set num_str = first.lesson_num if is_teacher else (first.display_num or first.lesson_num or '•') -%}

{#- ШАПКА УРОКА -#}
{%- if is_teacher -%}
{{ icon }} <b>{{ num_str }} урок</b> | <code>{{ start }}–{{ end }}</code>{{ '\n' }}
{%- else -%}
{{ icon }} <b>{{ num_str }} урок</b> | <code>{{ start }}–{{ end }}</code>{{ '\n' }}
{%- endif -%}

<blockquote>
{%- set subj_names = slot | map(attribute='subject_name') | reject('none') | join(' ') | lower -%}
{# ИЗМЕНЕНО: для school_search труд НЕ группируем — у каждой подгруппы свой учитель, нужно дерево из отдельных строк #}
{%- set is_trud = not is_teacher and not is_school_search and slot|length > 1 and ('труд' in subj_names or 'технологи' in subj_names) -%}

{%- if is_trud -%}
    {#- АГРЕГАЦИЯ ТРУДА -#}
    {%- set valid_rooms = slot | map(attribute='room_name') | reject('none') | reject('equalto', '—') | unique | list -%}
    {%- if is_all_cancelled -%}
        <s>Труд(технология)</s>
    {%- else -%}
        <b>Труд(технология)</b>{% if valid_rooms %} ➔ <b>[{{ valid_rooms | join(', ') }}]</b>{% endif -%}
    {%- endif -%}
{%- else -%}
    {#- ОБЫЧНЫЕ УРОКИ И ПОДГРУППЫ (Только актуальная инфа, без <s>Было</s>) -#}
    {%- for l in slot -%}
        {%- set parts = [] -%}
        {%- if is_teacher -%}
            {# ============================================================
               ИЗМЕНЕНО: новый порядок для УЧИТЕЛЯ.
               Было:  Предмет · Класс · Группа · [Кабинет]
               Стало: Класс · группа ➔ [Кабинет] · Предмет
               При отмене: зачеркиваем Класс/группу/Предмет, кабинет убираем.
               ============================================================ #}
            {%- set cls_grp_parts = [] -%}
            {%- if l.class_name %}{% set _ = cls_grp_parts.append('<b>' ~ l.class_name ~ '</b>') %}{% endif -%}
            {%- if l.group_name and l.group_name not in ['Весь класс', 'ALL', 'None', '', '—'] %}{% set _ = cls_grp_parts.append('<i>' ~ l.group_name ~ '</i>') %}{% endif -%}
            {%- set cls_grp = cls_grp_parts | join(' · ') | safe -%}

            {%- if l.is_cancelled -%}
                {%- set subj = l.original_subject_name if l.original_subject_name and l.original_subject_name != 'ОТМЕНА' else 'Урок' -%}
                <s>{{ cls_grp }}{% if cls_grp %} ➔ {% endif %}<i>{{ subj }}</i></s>
            {%- else -%}
                {{ cls_grp }}{% if cls_grp %} ➔ {% endif %}{% if l.room_name and l.room_name != '—' %}<b>[{{ l.room_name }}]</b> · {% endif %}<i>{{ l.subject_name }}</i>
            {%- endif -%}
        {%- else -%}
            {# ============================================================
               ИЗМЕНЕНО: новый порядок для УЧЕНИКА / ПОИСКА ПО ШКОЛЕ.
               Было:  Предмет · [Кабинет] · Преподаватель
               Стало: Предмет ➔ [Кабинет] · Преподаватель (только school_search)
               При отмене: зачеркиваем Предмет, кабинет убираем.
               Преподаватель при отмене не показываем — второстепенная инфа.
               ============================================================ #}
            {%- set tail_parts = [] -%}
            {%- if not l.is_cancelled and l.room_name and l.room_name != '—' %}{% set _ = tail_parts.append('<b>[' ~ l.room_name ~ ']</b>') %}{% endif -%}
            {%- if not l.is_cancelled and is_school_search and l.teacher_name %}{% set _ = tail_parts.append('<tg-spoiler><i>' ~ l.teacher_name ~ '</i></tg-spoiler>') %}{% endif -%}

            {%- if l.is_cancelled -%}
                {%- set old_subj = l.original_subject_name if l.original_subject_name and l.original_subject_name != 'ОТМЕНА' else 'Урок' -%}
                <s>{{ old_subj }}</s>
            {%- else -%}
                <b>{{ l.subject_name }}</b>{% if tail_parts %} ➔ {{ tail_parts | join(' · ') | safe }}{% endif -%}
            {%- endif -%}
        {%- endif -%}
        {%- if not loop.last %}{{ '\n' }}{% endif -%}
    {%- endfor -%}
{%- endif -%}
</blockquote>
{%- endif -%}
{%- endfor -%}
{%- endif -%}

{# ================= ФУТЕР (Приписка об изменениях) ================= #}
{%- if changes_count > 0 %}
{{ '\n' }}
<blockquote expandable>
⚠️ Изменений на сегодня: <b>{{ changes_count }}</b>{{ '\n' }}

{%- for slot in slots %}
{%- if not slot[0].is_extra %}
    {#- 1. Фильтруем: берем только уроки с изменениями в этом слоте -#}
    {%- set changed_lessons = [] -%}
    {%- for l in slot if l.is_cancelled or l.is_exchange -%}
        {%- set _ = changed_lessons.append(l) -%}
    {%- endfor -%}

    {%- if changed_lessons|length > 0 %}
        {%- set first = changed_lessons[0] %}
        {%- set start = first.start_time.zfill(5) if first.start_time else "00:00" %}
        {%- set end = first.end_time.zfill(5) if first.end_time else "00:00" %}
        
        {#- Если отменены ВСЕ подгруппы в слоте, ставим ❌, иначе 🔄 -#}
        {%- set is_all_cancelled = changed_lessons | rejectattr('is_cancelled') | list | length == 0 %}
        {%- set icon = '❌' if is_all_cancelled else '🔄' %}
        {%- set num_str = first.lesson_num if is_teacher else (first.display_num or first.lesson_num or '•') %}
        
        {#- ШАПКА ДЛЯ ИЗМЕНЕНИЙ -#}
        {# ИЗМЕНЕНО (п.4): убрано время, оставлен только номер урока #}
        {{ '\n' }}{{ icon }} <b>{{ num_str }} урок</b>
        
        {%- for l in changed_lessons %}
            {%- set is_last = loop.last %}
            {%- set prefix = "" if changed_lessons|length == 1 else ("  └ " if is_last else "  ├ ") %}
            
            {#- Извлекаем старые и новые значения -#}
            {%- set orig_subj = l.original_subject_name if l.original_subject_name and l.original_subject_name != 'ОТМЕНА' else (l.subject_name if l.subject_name != 'ОТМЕНА' else 'Урок') -%}
            {%- set new_subj = l.subject_name if l.subject_name else 'Урок' -%}
            
            {%- set orig_cls = l.original_class_name if l.original_class_name else '' -%}
            {%- set new_cls = l.class_name if l.class_name else '' -%}
            
            {%- set orig_room = l.original_room_name if l.original_room_name and l.original_room_name != '—' else '' -%}
            {%- set new_room = l.room_name if l.room_name and l.room_name != '—' else '' -%}
            
            {%- set orig_teacher = l.original_teacher_name if l.original_teacher_name and l.original_teacher_name != '—' else '' -%}
            {%- set new_teacher = l.teacher_name if l.teacher_name and l.teacher_name != '—' else '' -%}
            
            {%- set orig_grp = l.original_group_name if l.original_group_name and l.original_group_name not in ['Весь класс', 'ALL', 'None', '', '—'] else '' -%}
            {%- set new_grp = l.group_name if l.group_name and l.group_name not in ['Весь класс', 'ALL', 'None', '', '—'] else '' -%}
            
            {# ============================================================
               ИЗМЕНЕНО: вместо единого orig_core/new_core считаем дельты
               по отдельным полям — порядок и состав вывода теперь зависят
               от роли (учитель / ученик-поиск) и от того, что именно
               изменилось.
               ============================================================ #}
            {%- set subj_changed = orig_subj != new_subj -%}
            {%- set room_changed = orig_room != new_room -%}
            {%- set teacher_changed = orig_teacher != new_teacher -%}
            {%- set group_changed = orig_grp and new_grp and (orig_grp != new_grp) -%}
            {%- set clsgrp_changed = (orig_cls != new_cls) or (orig_grp != new_grp) -%}
            {# ИЗМЕНЕНО (п.3, п.6): если у урока вообще не было оригинала в базе —
               это добавленный урок, а не "замена одного поля". Ставим "—" на
               место "было" и показываем ПОЛНОСТЬЮ новые данные, а не только
               учителя (раньше из-за отсутствия orig_subject_name предмет
               считался "неизменным" и терялись класс/кабинет). -#}
            {%- set is_new_lesson = not l.original_subject_name -%}
            
            {#- Форматируем метку группы (ТОЛЬКО для учеников, у учителя группа внутри ядра) -#}
            {%- set grp_label = '' -%}
            {%- if not is_teacher -%}
                {%- if changed_lessons|length > 1 -%}
                    {%- if group_changed -%}
                        {%- set grp_label = '👥 <s>' ~ orig_grp ~ '</s> ➔ <b>' ~ new_grp ~ '</b>: ' -%}
                    {%- else -%}
                        {%- set grp_label = '👥 ' ~ (new_grp if new_grp else 'Весь класс') ~ ': ' -%}
                    {%- endif -%}
                {%- elif group_changed -%}
                    {%- set grp_label = ' (👥 <s>' ~ orig_grp ~ '</s> ➔ <b>' ~ new_grp ~ '</b>)' -%}
                {%- endif -%}
            {%- endif -%}
            
            {{ '\n' }}{{ prefix }}{% if changed_lessons|length > 1 %}{{ grp_label }}{% endif %}
            
            {%- if is_teacher -%}
                {# ============================================================
                   ИЗМЕНЕНО (п.2, п.3, п.6, п.7, п.8): ЗАМЕНЫ ДЛЯ УЧИТЕЛЯ.
                   Правило: внутри "было" и внутри "стало" части разделяются
                   ТОЛЬКО через " · " (класс · группа · [кабинет] · предмет).
                   Символ "➔" используется исключительно между "было" и "стало".
                   Если меняется только класс/группа/кабинет (предмет тот же) —
                   предмет не показываем. Если урока не было в базе — слева "—".
                   При отмене никакого "➔ ОТМЕНЕНО" — иконка ❌ и зачёркивание
                   уже говорят сами за себя.
                   ============================================================ #}
                {%- set old_parts = [] -%}
                {%- if orig_cls %}{% set _ = old_parts.append('<b>' ~ orig_cls ~ '</b>') %}{% endif -%}
                {%- if orig_grp %}{% set _ = old_parts.append('<i>' ~ orig_grp ~ '</i>') %}{% endif -%}
                {%- if orig_room %}{% set _ = old_parts.append('<b>[' ~ orig_room ~ ']</b>') %}{% endif -%}

                {%- set new_parts = [] -%}
                {%- if new_cls %}{% set _ = new_parts.append('<b>' ~ new_cls ~ '</b>') %}{% endif -%}
                {%- if new_grp %}{% set _ = new_parts.append('<i>' ~ new_grp ~ '</i>') %}{% endif -%}
                {%- if new_room %}{% set _ = new_parts.append('<b>[' ~ new_room ~ ']</b>') %}{% endif -%}

                {%- if l.is_cancelled -%}
                    {%- set _ = old_parts.append('<i>' ~ orig_subj ~ '</i>') -%}
                    <s>{{ old_parts | join(' · ') | safe }}</s>
                {%- elif is_new_lesson -%}
                    {%- set _ = new_parts.append('<i>' ~ new_subj ~ '</i>') -%}
                    <s>—</s> ➔ <b>{{ new_parts | join(' · ') | safe }}</b>
                {%- elif subj_changed -%}
                    {%- set _ = old_parts.append('<i>' ~ orig_subj ~ '</i>') -%}
                    {%- set _ = new_parts.append('<i>' ~ new_subj ~ '</i>') -%}
                    <s>{{ old_parts | join(' · ') | safe }}</s> ➔ <b>{{ new_parts | join(' · ') | safe }}</b>
                {%- elif clsgrp_changed or room_changed -%}
                    <s>{{ old_parts | join(' · ') | safe }}</s> ➔ <b>{{ new_parts | join(' · ') | safe }}</b>
                {%- elif teacher_changed -%}
                    {{ new_parts | join(' · ') | safe }} · (<s>{{ orig_teacher if orig_teacher else '—' }}</s> ➔ <b>{{ new_teacher if new_teacher else '—' }}</b>)
                {%- else -%}
                    {{ new_parts | join(' · ') | safe }} <i>(Замена)</i>
                {%- endif -%}

            {%- else -%}
                {# ============================================================
                   ИЗМЕНЕНО (п.3, п.5, п.6, п.7): ЗАМЕНЫ ДЛЯ УЧЕНИКА / ПОИСКА ПО ШКОЛЕ.
                   Внутри "было"/"стало" — Предмет · [Кабинет], разделитель
                   только " · ". "➔" — только между "было" и "стало".
                   - При отмене: просто зачёркнутый предмет, без "Отменено".
                   - Нет оригинала в базе (новый урок) — слева "—".
                   - Если меняется предмет — учителя не показываем вовсе.
                   - Если предмет тот же — проверяем кабинет и/или учителя
                     (могло измениться и то, и другое одновременно).
                   ============================================================ #}
                {%- if l.is_cancelled -%}
                    <s>{{ orig_subj }}</s>
                {%- elif is_new_lesson -%}
                    {%- set new_parts = ['<b>' ~ new_subj ~ '</b>'] -%}
                    {%- if new_room %}{% set _ = new_parts.append('<b>[' ~ new_room ~ ']</b>') %}{% endif -%}
                    <s>—</s> ➔ <b>{{ new_parts | join(' · ') | safe }}</b>
                {%- elif subj_changed -%}
                    {%- set old_parts = ['<b>' ~ orig_subj ~ '</b>'] -%}
                    {%- if orig_room %}{% set _ = old_parts.append('<b>[' ~ orig_room ~ ']</b>') %}{% endif -%}
                    {%- set new_parts = ['<b>' ~ new_subj ~ '</b>'] -%}
                    {%- if new_room %}{% set _ = new_parts.append('<b>[' ~ new_room ~ ']</b>') %}{% endif -%}
                    <s>{{ old_parts | join(' · ') | safe }}</s> ➔ <b>{{ new_parts | join(' · ') | safe }}</b>
                {%- elif room_changed and teacher_changed and is_school_search -%}
                    <b>{{ new_subj }}</b> · <s>[{{ orig_room if orig_room else '—' }}]</s> ➔ <b>[{{ new_room if new_room else '—' }}]</b> · (<s>{{ orig_teacher if orig_teacher else '—' }}</s> ➔ <b>{{ new_teacher if new_teacher else '—' }}</b>)
                {%- elif room_changed -%}
                    <b>{{ new_subj }}</b> · <s>[{{ orig_room if orig_room else '—' }}]</s> ➔ <b>[{{ new_room if new_room else '—' }}]</b>
                {%- elif teacher_changed -%}
                    {%- if is_school_search -%}
                        <tg-spoiler>(<s>{{ orig_teacher if orig_teacher else '—' }}</s> ➔ <b>{{ new_teacher if new_teacher else '—' }}</b>)</tg-spoiler>
                    {%- else -%}
                        (<s>{{ orig_teacher if orig_teacher else '—' }}</s> ➔ <b>{{ new_teacher if new_teacher else '—' }}</b>)
                    {%- endif -%}
                {%- else -%}
                    <b>{{ new_subj }}</b>{% if new_room %} · <b>[{{ new_room }}]</b>{% endif %} <i>(Замена)</i>
                {%- endif -%}
            {%- endif -%}
            
            {#- Если урок одиночный, но группа сменилась, прилепляем метку в конец -#}
            {%- if changed_lessons|length == 1 %}{{ grp_label }}{% endif -%}
            
        {%- endfor %}
    {%- endif %}
{%- endif %}
{%- endfor %}
</blockquote>
{%- endif %}